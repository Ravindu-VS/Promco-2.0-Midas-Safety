{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Json",
    "JsonFilePath": "App_Data/promco-data.json"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=PromcoDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "CHANGE_ME_to_a_long_random_secret_at_least_32_characters",
    "ExpiryHours": 8
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Seed": {
    "DemoAccounts": false,
    "SampleData": false
  }
}
